# API Environment Variables

# Database Connection String
# For PostgreSQL (production/local): Host=localhost;Database=donaciones;Username=postgres;Password=yourpassword
# Leave empty to use InMemory database (development only - data not persisted)
ConnectionStrings__Default=

# CORS Allowed Origins (comma-separated)
# Example: http://localhost:3000,https://yourapp.onrender.com
Cors__AllowedOrigins=http://localhost:3000

# JWT Authentication Settings
# IMPORTANT: Use a strong, randomly generated secret in production
# Generate a secure secret with: openssl rand -base64 32
Jwt__Secret=ThisIsADevelopmentSecretKeyThatIsAtLeast32CharactersLong!
Jwt__Issuer=Donaciones.Api
Jwt__Audience=Donaciones.Client
Jwt__ExpiryMinutes=480

# Google OAuth Configuration (optional)
# Required for Google Sign-In functionality
# Get from: https://console.cloud.google.com/apis/credentials
Google__ClientId=
