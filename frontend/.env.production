# Production environment variables for Render.com
# The API URL should be set in Render.com dashboard as an environment variable
# This file provides defaults, but REACT_APP_API_BASE_URL should be configured in Render

# IMPORTANT: Set this in your Render.com environment variables to your actual API URL
# Example: https://your-api-name.onrender.com
REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL}
