# Frontend environment variables
# Copy this file to `.env` and adjust values if needed.

# Backend API base URL. Default (when omitted) is http://localhost:5047 as per api/Donaciones.Api launch profile.
REACT_APP_API_BASE_URL=http://localhost:5047

# Google OAuth client ID for Google Identity Services (optional). If not set, the Google button on /login is hidden.
REACT_APP_GOOGLE_CLIENT_ID=
